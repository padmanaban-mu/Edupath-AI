# Environment variables & secrets
.env
.env.*
*.local
!.env.example

# Dependency directories
node_modules/
jspm_packages/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Logs & Runtime
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build and Temporary Output
dist/
dist-ssr/
build/
.tmp/
.cache/
tmp/
temp/

# OS Artifacts & System Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor & IDE configurations
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
*~
.vscode/*
!.vscode/extensions.json

# Scratch notes, drafts & temporary text files
New Text Document*.txt
